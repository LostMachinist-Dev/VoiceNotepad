/* Template. build.rs substitutes @COMMA_VERSION@ and @VERSION@ from
   Cargo.toml and compiles the result, so the version shown in Explorer's
   file properties cannot drift away from the crate version. Edit the
   version in Cargo.toml, not here.

   No #include: every value below is a numeric literal, and pulling in
   winver.h would need the Windows SDK headers on the include path, which
   llvm-rc does not have when cross-compiling. */

/* Resource id 1 is what Explorer and the taskbar show for the exe. */
1 ICON "voice-notepad.ico"

1 VERSIONINFO
FILEVERSION     @COMMA_VERSION@
PRODUCTVERSION  @COMMA_VERSION@
FILEOS          0x40004L   /* VOS_NT_WINDOWS32 */
FILETYPE        0x1L       /* VFT_APP */
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"   /* US English, Unicode */
        BEGIN
            VALUE "CompanyName",      "Voice Notepad"
            VALUE "FileDescription",  "Voice Notepad - Notepad with local speech to text"
            VALUE "FileVersion",      "@VERSION@"
            VALUE "InternalName",     "VoiceNotepad"
            VALUE "OriginalFilename", "VoiceNotepad.exe"
            VALUE "ProductName",      "Voice Notepad"
            VALUE "ProductVersion",   "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
