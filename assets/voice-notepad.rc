#include <winver.h>

/* Resource id 1 is what Explorer and the taskbar show for the exe. */
1 ICON "voice-notepad.ico"

1 VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEOS          0x40004L   /* VOS_NT_WINDOWS32 */
FILETYPE        0x1L       /* VFT_APP */
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"   /* US English, Unicode */
        BEGIN
            VALUE "CompanyName",      "Voice Notepad"
            VALUE "FileDescription",  "Voice Notepad - Notepad with local speech to text"
            VALUE "FileVersion",      "1.1.0"
            VALUE "InternalName",     "VoiceNotepad"
            VALUE "OriginalFilename", "VoiceNotepad.exe"
            VALUE "ProductName",      "Voice Notepad"
            VALUE "ProductVersion",   "1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
